# Copy to apps/api/.env for local development (`cp .env.example .env`).
# .env is gitignored. These values match docker/postgres/init-roles.sql and are
# LOCAL DEV ONLY. In production, set real values as environment variables.

# JDBC URL of the hisaab database
DB_URL=jdbc:postgresql://localhost:5432/hisaab

# Runtime role: the API connects as this. Owns no tables, cannot bypass RLS.
DB_APP_USER=hisaab_app
DB_APP_PASSWORD=hisaab_dev_app

# Owner role: Flyway uses this to run migrations at startup.
DB_OWNER_USER=hisaab_owner
DB_OWNER_PASSWORD=hisaab_dev_owner

# The only origin CORS allows (the Next.js app)
WEB_ORIGIN=http://localhost:3000

# Signs access tokens (HMAC-SHA256); at least 32 characters. This value is
# LOCAL DEV ONLY. In production generate your own: `openssl rand -base64 48`
JWT_SECRET=dev-only-jwt-secret-change-me-in-production-0123456789

# Dues digest email (optional in dev). Leave MAIL_FROM blank and nothing is sent.
# Brevo: Settings > SMTP & API > SMTP. MAIL_USERNAME is the SMTP login shown there,
# MAIL_PASSWORD is an SMTP key (not your Brevo account password), and MAIL_FROM must be
# a sender address you verified in Brevo.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Attachment storage: any S3-compatible service. These values match the s3mock container in
# docker-compose.yml and are LOCAL DEV ONLY. In production use Cloudflare R2: endpoint
# https://<account-id>.r2.cloudflarestorage.com, region auto, and an R2 API token's keys.
STORAGE_ENDPOINT=http://localhost:9090
STORAGE_REGION=us-east-1
STORAGE_BUCKET=hisaab
STORAGE_ACCESS_KEY=local-dev
STORAGE_SECRET_KEY=not-checked-by-s3mock
